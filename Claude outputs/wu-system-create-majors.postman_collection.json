{
  "info": {
    "name": "WU System - Create Majors",
    "description": "Creates the 17 majors you listed via POST /api/v1/majors. The API sits behind the app's normal session-based 'web' auth (bootstrap/app.php puts the api group inside the 'web' middleware group, no Sanctum/token guard), so the two 'Login' requests at the top must run first in the same Postman session to get an authenticated cookie before the Create Major requests will work.\n\nBefore running:\n1. Set 'base_url' below to your app's real URL (default assumes local dev).\n2. Set 'login_email' / 'login_password' to a real user with majors.create permission.\n3. Every Create Major request has \"name_kh\": \"\" (left blank on purpose - I didn't want to guess an official Khmer translation) and \"faculty_id\": 1 (a placeholder - fill in the real faculty for each major, they almost certainly aren't all the same faculty). Shortcuts are my best-guess abbreviations (a few, like CNT/DCA/DIM/TSHS/ENGCOM, are taken from the real shift-code prefixes seen in your URM export; the rest - ARCH, CE, ECD, IR - are inferred since no sample data existed for them) - check them against your existing shortcut",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "login_email", "value": "" },
    { "key": "login_password", "value": "" },
    { "key": "csrf_token", "value": "" }
  ],
  "item": [
    {
      "name": "Step 1 - Get login page (CSRF cookie + token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const match = pm.response.text().match(/name=\"_token\"\\s+value=\"([^\"]+)\"/);",
              "if (match) { pm.collectionVariables.set('csrf_token', match[1]); }",
              "else { console.warn('Could not find _token on the login page - check the form markup.'); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Step 2 - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "_token", "value": "{{csrf_token}}" },
            { "key": "email", "value": "{{login_email}}" },
            { "key": "password", "value": "{{login_password}}" }
          ]
        },
        "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
      }
    },
    {
      "name": "Create Majors",
      "item": [
        { "name": "Create Major - Accounting", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"name_en\": \"Accounting\",\n  \"name_kh\": \"\",\n  \"shortcut\": \"ACC\",\n  \"faculty_id\": 1,\n  \"remark\": \"\"\n}" }, "url": { "raw": "{{base_url}}/api/v1/majors", "host": ["{{base_url}}"], "path": ["api", "v1", "majors"] } } },
        { "name": "Create Major - Architecture", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"name_en\": \"Architecture\",\n  \"name_kh\": \"\",\n  \"shortcut\": \"ARCH\",\n  \"faculty_id\": 1,\n  \"remark\": \"\"\n}" }, "url": { "raw": "{{base_url}}/api/v1/majors", "host": ["{{base_url}}"], "path": ["api", "v1", "majors"] } } },
